<%- include('header') %>

<section class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <div class="page-header-title">
                            <h2 class="m-b-10">Edit Admin</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="card p-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <form action="/editAdminData/<%= adminRecord._id %>" method="POST" enctype="multipart/form-data">

                                    <div class="form-group">
                                        <label for="name">Full Name</label>
                                        <input type="text" class="form-control" id="name" name="name"
                                            placeholder="Enter Full Name"
                                            value="<%= adminRecord.name %>" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="email">Email</label>
                                        <input type="email" class="form-control" id="email" name="email"
                                            placeholder="Enter Email"
                                            value="<%= adminRecord.email %>" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="password">Password <small class="text-muted">(leave blank to keep current)</small></label>
                                        <input type="password" class="form-control" id="password" name="password"
                                            placeholder="Enter New Password">
                                    </div>

                                    <fieldset class="form-group">
                                        <div class="row align-items-center">
                                            <label class="col-sm-2 col-form-label">Gender</label>
                                            <div class="col-sm-6 d-flex gap-4">
                                                <div class="form-check mr-3">
                                                    <input class="form-check-input" type="radio" name="gender"
                                                        id="genderMale" value="male"
                                                        <%= adminRecord.gender === 'male' ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="genderMale">Male</label>
                                                </div>
                                                <div class="form-check mr-3">
                                                    <input class="form-check-input" type="radio" name="gender"
                                                        id="genderFemale" value="female"
                                                        <%= adminRecord.gender === 'female' ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="genderFemale">Female</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="gender"
                                                        id="genderOther" value="other"
                                                        <%= adminRecord.gender === 'other' ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="genderOther">Other</label>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>

                                    <div class="mb-3">
                                        <label class="form-label">Current Profile Image</label><br>
                                        <% if (adminRecord.avtar) { %>
                                            <img src="<%= adminRecord.avtar %>" 
                                                 width="80" height="80" 
                                                 style="border-radius:50%; object-fit:cover; margin-bottom:10px;">
                                        <% } else { %>
                                            <span class="text-muted">No image uploaded</span>
                                        <% } %>
                                    </div>

                                    <div class="mb-3">
                                        <label for="avatar" class="form-label">Change Profile Image <small class="text-muted">(leave blank to keep current)</small></label>
                                        <div class="custom-file">
                                            <input type="file" class="custom-file-input" id="avatar" name="avtar"
                                                accept="image/*">
                                            <label class="custom-file-label" for="avatar">Choose file</label>
                                        </div>
                                    </div>

                                    <a href="/view-admin" class="btn btn-secondary mr-2">Cancel</a>
                                    <button type="submit" class="btn btn-primary">Update Admin</button>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<%- include('footer') %>