<%- include('header') %>

<section class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="card">
            <div class="card-header">
                <h4>Trash Records</h4>
            </div>

            <div class="card-body">
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% trashData.forEach((item,index)=>{ %>

                        <tr>

                            <td><%= index+1 %></td>

                            <td>
                                <% if(type=='category'){ %>

                                    <%= item.cName %>

                                <% } else if(type=='subcategory'){ %>

                                    <%= item.subcName %>

                                <% } else if(type=='extracategory'){ %>

                                    <%= item.extracName %>

                                <% } %>
                            </td>

                            <td>
                                <%= type %>
                            </td>
                            
                            <td>

                                <% if(type=='category'){ %>

                                    <a href="/restore-category/<%= item._id %>"
                                       class="btn btn-success btn-sm">
                                        Restore
                                    </a>

                                    <a href="/permanent-delete-category/<%= item._id %>"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                <% } else if(type=='subcategory'){ %>

                                    <a href="/restore-subcategory/<%= item._id %>"
                                       class="btn btn-success btn-sm">
                                        Restore
                                    </a>

                                    <a href="/permanent-delete-subcategory/<%= item._id %>"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                <% } else { %>

                                    <a href="/restore-extracategory/<%= item._id %>"
                                       class="btn btn-success btn-sm">
                                        Restore
                                    </a>

                                    <a href="/permanent-delete-extracategory/<%= item._id %>"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                <% } %>

                            </td>

                        </tr>

                        <% }) %>

                    </tbody>

                </table>
            </div>
        </div>

    </div>
</section>

<%- include('footer') %>