<%- include('header') %>

<section class="pcoded-main-container">
    <div class="pcoded-content">

        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <div class="page-header-title">
                            <h2 class="m-b-10">View Admins</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>All Admins</h5>
                        <a href="/trash-admin" class="btn btn-primary btn-sm">Trash</a>
                    </div>
                    <div class="card-body table-border-style">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Profile Picture</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Gender</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (adminData && adminData.length > 0) { %>
                                        <% adminData.forEach(function(admin, index) { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td>
                                                <img
                                                    src="<%= admin.avtar ? '/uploads/adminImages/' + admin.avtar : '/assets/images/user/default-avatar.webp' %>"
                                                    width="50"
                                                    height="50"
                                                    style="border-radius:50%; object-fit:cover; border:1px solid #ddd;"
                                                    alt="Avatar"
                                                    onerror="this.src='/assets/images/user/default-avatar.webp'">
                                            </td>

                                            <td><%= admin.name %></td>
                                            <td><%= admin.email %></td>
                                            <td><%= admin.role %></td>
                                            <td><%= admin.gender %></td>

                                            <td>
                                                <a href="/update-admin/<%= admin._id %>" 
                                                   class="btn btn-sm btn-warning mr-1">
                                                    Edit
                                                </a>
                                                <a href="/deleteAdmin/<%= admin._id %>" 
                                                   class="btn btn-sm btn-danger"
                                                   onclick="return confirm('Are you sure you want to delete this admin?')">
                                                    Delete
                                                </a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center text-muted">
                                                No admins found. <a href="/add-admin">Add one?</a>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<%- include('footer') %>
