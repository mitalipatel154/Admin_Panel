<%- include('header') %>

    <section class="pcoded-main-container">
        <div class="pcoded-content">

            <div class="page-header">
                <div class="page-block">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <div class="page-header-title">
                                <h2 class="m-b-10">View Extra Category</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5>All Categorys</h5>
                            <a href="/trash-extracategory" class="btn btn-primary btn-sm">Trash</a>
                        </div>
                        <div class="card-body table-border-style">
                            <div class="table-responsive">
                                <table class="table">

                                    <thead>

                                        <tr>

                                            <th>#</th>
                                            <th>Extra Category</th>
                                            <th>Sub Category</th>
                                            <th>Status</th>
                                            <th>Action</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% extraCategoryData.forEach((extra,index)=>{ %>

                                            <tr>

                                                <td>
                                                    <%= index+1 %>
                                                </td>

                                                <td>
                                                    <%= extra.extracName %>
                                                </td>

                                                <td>
                                                    <%= extra.subCategoryId.subcName %>
                                                </td>

                                                <td>
                                                    <% if(user && (user.role === 'Super Admin' || user.role === 'Admin')) { %>

                                                        <label class="switch">
                                                            <input
                                                                type="checkbox"
                                                                <%= extra.status ? 'checked' : '' %>
                                                                onchange="window.location.href='/change-extracategory-status/<%= extra._id %>'"
                                                            >
                                                            <span class="slider"></span>
                                                        </label>

                                                    <% } else { %>
                                                        <%= extra.status ? 'Active' : 'Inactive' %>
                                                    <% } %>
                                                </td>

                                                <td>
                                                    <% if(user && (user.role === 'Super Admin' || user.role === 'Admin')) { %>
                                                        <a href="/edit-extracategory/<%= extra._id %>"
                                                        class="btn btn-warning btn-sm">
                                                            Edit
                                                        </a>
                                                        <a href="/delete-extracategory/<%= extra._id %>"
                                                        class="btn btn-danger btn-sm">
                                                            Delete
                                                        </a>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <%- include('footer') %>